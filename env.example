# Copy this file to ".env" next to compose.yaml and adjust. Everything is optional.

# Host port (bound to 127.0.0.1 only).
MACROCART_PORT=5000

# Folder that holds NutriTrace's "db/nutritrace.db" and "uploads/". Mounted read-only.
NUTRITRACE_DIR=./nutritrace

# Open Food Facts search: limit to a country (OFF tag, e.g. en:spain, en:france),
# empty = worldwide; language for product names (two letters).
OFF_COUNTRY=
OFF_LANG=en
# OFF asks API users for an identifiable User-Agent: app name plus a contact.
OFF_USER_AGENT=macrocart/1.0 (self-hosted)

# Shops offered in the price and filter pickers, comma-separated.
SUPERMARKETS=
